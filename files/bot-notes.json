{
  // A short write-up for each bot, shown at the top of its page. Keyed by the game's role name (any case); a bot
  // with several roles uses the first one found here. Edit freely, add your mods' bots: your copy is kept on update.
  "bossBully": "Reshala runs the gang that holds the Customs dormitories and new gas station. A dealer in drugs and weapons, he carries a gold-plated TT and never goes anywhere without his guards, who do most of the fighting while he hangs back.",
  "followerBully": "Reshala's bodyguards. Armoured and well armed, they stay close to him and swarm anyone who gets near.",
  "bossKilla": "Killa haunts the ULTRA mall on Interchange. Heavily armoured in a Maska helmet and body armour, he hunts alone with a light machine gun or shotgun, suppressing and rushing his targets.",
  "bossKojaniy": "Shturman holds the lumber mill on Woods with his men. A patient long-range shooter, he picks people off with a marksman rifle from cover rather than charging.",
  "followerKojaniy": "Shturman's men, guarding the lumber mill with him.",
  "bossGluhar": "Glukhar commands a large crew of former soldiers on Reserve (and, on this server, wherever spawns put him). He stays back while his assault, security and scout squads fight.",
  "followerGluharAssault": "Glukhar's assault squad: aggressive, well armed, the first to push.",
  "followerGluharSecurity": "Glukhar's close protection, staying near him.",
  "followerGluharScout": "Glukhar's scouts, ranging ahead of the group.",
  "bossSanitar": "Sanitar, the medic of the Azure Coast resort on Shoreline, runs a trade in drugs and medicine around it. He heals and uses stimulants mid-fight, and his guards cover him.",
  "followerSanitar": "Sanitar's guards around the Shoreline resort.",
  "bossTagilla": "Tagilla prowls Factory in a welding mask. He charges with a sledgehammer or tears in with a shotgun, and he's very hard to put down.",
  "bossKnight": "Knight leads the Goons, three former PMC operators turned rogue who roam between maps. He's the one up front, well armoured with an assault rifle.",
  "followerBigPipe": "Big Pipe, the Goons' heavy: grenade launcher and assault rifle, rushing in with Knight.",
  "followerBirdEye": "Birdeye, the Goons' marksman. He hangs back with a silenced rifle and hunts anyone who moves on his team.",
  "bossZryachiy": "Zryachiy, a cultist marksman, watches over Lightkeeper's island on Lighthouse with his followers.",
  "followerZryachiy": "Zryachiy's followers on Lightkeeper's island.",
  "bossBoar": "Kaban runs the Lexos car dealership on Streets of Tarkov like a fortress, with guards, snipers and machine-gun posts.",
  "followerBoar": "Kaban's guards at the car dealership.",
  "bossBoarSniper": "Kaban's snipers, watching the streets around the dealership.",
  "bossKolontay": "Kollontay, a former police colonel, leads armed men through Streets of Tarkov and Ground Zero. He'll beat intruders down with his baton as readily as he shoots.",
  "followerKolontayAssault": "Kollontay's assault men.",
  "followerKolontaySecurity": "Kollontay's close security.",
  "bossPartisan": "Partisan is a veteran who protects the city's Scavs from the PMCs who prey on them. He sets tripwires and stalks players, and he leaves alone those who don't kill Scavs.",
  "pmcBot": "Raiders: highly trained former military guarding Reserve's underground bunkers and The Lab. They fight as a team and react fast.",
  "exUsec": "Rogues: former USEC operators who took over the Lighthouse water treatment plant. Well armoured, with machine guns and grenade launchers on their positions.",
  "sectantPriest": "The cult's priests. They come out at night with their warriors and knives that poison.",
  "sectantWarrior": "Cultists: a silent cult that comes out at night, often in the woods. Their knives poison, and they strike from close range without warning.",
  "assault": "Scavs: the locals who stayed in Tarkov and loot what's left. Poorly equipped and loosely organised, they fight anyone who isn't one of them.",
  "marksman": "Scav snipers: Scavs set up with a rifle on high ground, covering the roads and open ground.",
  "cursedAssault": "Scavs gone over to the cult, seen during events.",
  "crazyAssaultEvent": "Crazed Scavs, seen during events.",
  "pmcUSEC": "USEC operators: PMCs from the private military company that worked for TerraGroup, now fighting their way out of Tarkov.",
  "pmcBEAR": "BEAR operators: PMCs from the company hired by the Russian government to investigate TerraGroup, fighting their way out of Tarkov.",
  "arenaFighterEvent": "Bloodhounds: fighters from the Arena, seen during events.",
  "infectedAssault": "The infected, seen only during the zombie event."
}
